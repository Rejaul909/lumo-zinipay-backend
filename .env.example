# --------------------------------------------------------------
# LUMO ZiniPay backend — environment variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git.
# --------------------------------------------------------------

# Your ZiniPay Brand / API key (Dashboard -> Main Menu -> Brands)
# Use your sandbox key while testing, live key only in production.
ZINIPAY_API_KEY=your_zinipay_brand_api_key_here

# Your live site URL — used to build redirect_url, cancel_url and
# webhook_url when creating a ZiniPay invoice. Must match the
# domain registered against your ZiniPay brand.
APP_BASE_URL=https://yourdomain.com

# A random secret string of your choosing. Appended to the webhook
# URL as ?token=... so random internet traffic can't call your
# webhook endpoint. Generate one with e.g. `openssl rand -hex 20`.
WEBHOOK_SECRET=change_this_to_a_long_random_string

# Port the backend listens on
PORT=3000
